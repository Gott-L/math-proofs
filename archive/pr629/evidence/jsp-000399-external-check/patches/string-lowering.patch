+/-- Expand a Lean 4.19 string literal into its ordinary constructor expression.
+The source string is traversed by Unicode scalar values, not UTF-8 bytes. -/
+def lowerStringLiteral (s : String) : Expr :=
+  let charType := mkConst ``Char
+  let nil := mkApp (mkConst ``List.nil [Level.zero]) charType
+  let chars := s.toList.foldr (fun c tail =>
+    mkApp3 (mkConst ``List.cons [Level.zero]) charType
+      (mkApp (mkConst ``Char.ofNat) (mkNatLit c.toNat)) tail) nil
+  mkApp (mkConst ``String.mk) chars
